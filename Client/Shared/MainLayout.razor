@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar @(sidebarCollapsed ? "collapsed" : null)">
        <NavMenu Collapsed="sidebarCollapsed" OnToggleCollapsed="ToggleSidebar" />
    </div>

    <main>
       @* <div class="top-row px-4">
            <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
        </div>*@

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private const string SidebarStorageKey = "sidebarCollapsed";
    private bool sidebarCollapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // Restore the per-browser sidebar state; ignore storage errors (private mode, blocked storage).
        try
        {
            sidebarCollapsed = await JS.InvokeAsync<string?>("localStorage.getItem", SidebarStorageKey) == "true";
            if (sidebarCollapsed)
                StateHasChanged();
        }
        catch (JSException) { }
    }

    private async Task ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SidebarStorageKey, sidebarCollapsed ? "true" : "false");
        }
        catch (JSException) { }
    }
}
