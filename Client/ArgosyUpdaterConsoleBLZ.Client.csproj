<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="35.1.37" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="35.1.37" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\ArgosyUpdaterConsoleBLZ.Shared.csproj" />
  </ItemGroup>

  <!-- Template for the git-ignored wwwroot/appsettings.json; not part of the build output. -->
  <ItemGroup>
    <Content Remove="appsettings.template.json" />
    <None Include="appsettings.template.json" />
  </ItemGroup>

  <Target Name="WarnMissingClientAppSettings" BeforeTargets="Build" Condition="!Exists('wwwroot\appsettings.json')">
    <Warning Text="Client/wwwroot/appsettings.json is missing - copy Client/appsettings.template.json and set Syncfusion:LicenseKey, otherwise Syncfusion shows a license banner." />
  </Target>

</Project>
